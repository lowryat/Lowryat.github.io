// ============================================================================
// EMA ATR Trend Strategy  (tradingbot port for TradingView)
// ============================================================================
// HOW TO USE
// ----------
// 1. Open a DAILY chart for BTCUSD, ETHUSD, SOLUSD, or AVAXUSD.
// 2. Open Pine Script Editor → paste this script → "Add to chart".
// 3. Click Strategy Tester to review historical results.
// 4. For live paper trading: Trading Panel sidebar → Paper Trading → ▶
// 5. Set up alerts via the Alert Conditions below for push notifications.
//
// PORTFOLIO NOTE
// --------------
// TradingView runs one script per chart/symbol. The daily/weekly circuit
// breakers here are per-symbol only. For full multi-asset portfolio risk
// management use tradingbot.live (Alpaca paper path).
// ============================================================================

//@version=5
strategy(
     title             = "EMA ATR Trend (tradingbot)",
     shorttitle        = "EAT",
     overlay           = true,
     pyramiding        = 0,
     default_qty_type  = strategy.fixed,
     default_qty_value = 0,
     initial_capital   = 10000,
     currency          = currency.USD,
     commission_type   = strategy.commission.percent,
     commission_value  = 0.1,
     slippage          = 2,
     calc_on_every_tick = false)

// ── INPUTS ────────────────────────────────────────────────────────────────────
var GRP_EMA  = "EMA Parameters"
fast        = input.int  (12,   "Fast EMA Period",           group=GRP_EMA, minval=2)
slow_p      = input.int  (48,   "Slow EMA Period",           group=GRP_EMA, minval=2)
regime_len  = input.int  (100,  "Regime EMA Period",         group=GRP_EMA, minval=2)

var GRP_RISK = "Risk / Sizing"
atr_len     = input.int  (14,   "ATR Period",                group=GRP_RISK, minval=1)
atr_init    = input.float(2.5,  "ATR Initial Stop Mult",     group=GRP_RISK, step=0.1, minval=0.5)
atr_trail   = input.float(3.0,  "ATR Trail Mult (Chandelier)",group=GRP_RISK, step=0.1, minval=0.5)
risk_pct    = input.float(2.0,  "Risk Per Trade (% equity)", group=GRP_RISK, step=0.1, minval=0.1, maxval=10)
max_alloc   = input.float(25.0, "Max Alloc Per Symbol (%)",  group=GRP_RISK, step=1, minval=1, maxval=100)

var GRP_CB   = "Circuit Breakers"
dd_daily    = input.float(3.0,  "Daily DD Limit (%)",        group=GRP_CB, step=0.1, minval=0.1)
dd_weekly   = input.float(5.0,  "Weekly DD Limit (%)",       group=GRP_CB, step=0.1, minval=0.1)

// ── INDICATORS ────────────────────────────────────────────────────────────────
ema_fast   = ta.ema(close, fast)
ema_slow   = ta.ema(close, slow_p)
ema_regime = ta.ema(close, regime_len)
atr_val    = ta.atr(atr_len)

// ── ENTRY / EXIT SIGNALS ──────────────────────────────────────────────────────
bullish_regime = close > ema_regime
cross_up       = ta.crossover(ema_fast, ema_slow)  and bullish_regime
cross_down     = ta.crossunder(ema_fast, ema_slow)

// ── CHANDELIER TRAILING STOP ──────────────────────────────────────────────────
// Ratchets upward only — never moves against the position.
var float chan_peak = na
var float chan_stop = na
in_pos = strategy.position_size > 0

if in_pos
    chan_peak := math.max(nz(chan_peak, high), high)
    chan_stop := chan_peak - atr_trail * atr_val
else
    chan_peak := na
    chan_stop := na

stop_hit = in_pos and low < chan_stop

// ── POSITION SIZING ───────────────────────────────────────────────────────────
// Mirrors risk/manager.py:
//   risk_dollars  = equity * risk_pct / 100
//   stop_distance = atr_init * ATR(14)
//   qty           = risk_dollars / stop_distance
//   capped at:    equity * max_alloc / 100 / close
equity      = strategy.equity
risk_dollars = equity * risk_pct / 100.0
stop_dist    = atr_init * atr_val
raw_qty      = stop_dist > 0 ? risk_dollars / stop_dist : 0.0
cap_qty      = close   > 0 ? equity * max_alloc / 100.0 / close : 0.0
entry_qty    = math.min(raw_qty, cap_qty)

// ── CIRCUIT BREAKERS (per-symbol approximation on daily bars) ─────────────────
// On a daily chart every bar = one trading day, so:
//   daily DD   = how much today's equity fell vs yesterday's closing equity
//   weekly DD  = how much equity fell from its 5-bar rolling peak (≈1 ISO week)
//
// Both are computed fresh each bar — no state needed.
prev_equity  = nz(strategy.equity[1], equity)
dd_day_now   = prev_equity > 0.0 ? math.max(0.0, (prev_equity - equity) / prev_equity) : 0.0
week_peak    = ta.highest(strategy.equity, 5)
dd_week_now  = week_peak  > 0.0 ? math.max(0.0, (week_peak  - equity) / week_peak)  : 0.0

halted_day   = dd_day_now  >= dd_daily  / 100.0
halted_week  = dd_week_now >= dd_weekly / 100.0
halted       = halted_day or halted_week

// Flatten immediately when circuit breaker fires
if halted and in_pos
    strategy.close_all(comment="circuit_breaker")

// ── ENTRIES & EXITS ───────────────────────────────────────────────────────────
if cross_up and not halted and entry_qty > 0.0
    strategy.entry("Long", strategy.long, qty=entry_qty, comment="ema_cross_up")

if cross_down and in_pos
    strategy.close("Long", comment="ema_cross_down")

if stop_hit and in_pos
    strategy.close("Long", comment="chandelier_stop")

// ── PLOTS ─────────────────────────────────────────────────────────────────────
plot(ema_fast,   "EMA Fast",   color=color.blue,             linewidth=1)
plot(ema_slow,   "EMA Slow",   color=color.orange,           linewidth=1)
plot(ema_regime, "EMA Regime", color=color.new(color.gray,0),linewidth=1)
plot(in_pos ? chan_stop : na,  "Chandelier Stop",
     color=color.red, linewidth=2, style=plot.style_cross)

bgcolor(halted   ? color.new(color.red,   88) : na, title="Halted")
bgcolor(cross_up ? color.new(color.green, 88) : na, title="Entry signal")
bgcolor(stop_hit ? color.new(color.red,   80) : na, title="Stop hit")

// Trade P&L label on close of each trade
if strategy.closedtrades > strategy.closedtrades[1]
    pnl = strategy.closedtrades.profit(strategy.closedtrades - 1)
    label.new(bar_index, high,
         text      = (pnl >= 0 ? "+" : "") + str.tostring(math.round(pnl, 0)),
         color     = pnl >= 0 ? color.green : color.red,
         style     = label.style_label_down,
         textcolor = color.white,
         size      = size.small)

// Info table (top-right corner)
var table tbl = table.new(position.top_right, 2, 8,
     bgcolor=color.new(color.black, 70), border_width=1)

if barstate.islast
    table.cell(tbl, 0, 0, "Strategy",   text_color=color.white,  text_size=size.small)
    table.cell(tbl, 1, 0, "EMA ATR Trend",text_color=color.yellow,text_size=size.small)
    table.cell(tbl, 0, 1, "Equity",     text_color=color.white,  text_size=size.small)
    table.cell(tbl, 1, 1, "$" + str.tostring(math.round(equity, 0)),
               text_color=color.white, text_size=size.small)
    table.cell(tbl, 0, 2, "DD (day)",   text_color=color.white,  text_size=size.small)
    table.cell(tbl, 1, 2, str.tostring(math.round(dd_day_now * 100, 2)) + "%",
               text_color=halted_day ? color.red : color.lime, text_size=size.small)
    table.cell(tbl, 0, 3, "DD (week)",  text_color=color.white,  text_size=size.small)
    table.cell(tbl, 1, 3, str.tostring(math.round(dd_week_now * 100, 2)) + "%",
               text_color=halted_week ? color.red : color.lime, text_size=size.small)
    table.cell(tbl, 0, 4, "Halted",     text_color=color.white,  text_size=size.small)
    table.cell(tbl, 1, 4, halted ? "YES ⛔" : "No ✓",
               text_color=halted ? color.red : color.lime, text_size=size.small)
    table.cell(tbl, 0, 5, "Position",   text_color=color.white,  text_size=size.small)
    table.cell(tbl, 1, 5, in_pos ? str.tostring(math.round(strategy.position_size, 4)) + " units" : "Flat",
               text_color=in_pos ? color.blue : color.gray, text_size=size.small)
    table.cell(tbl, 0, 6, "Chan. Stop", text_color=color.white,  text_size=size.small)
    table.cell(tbl, 1, 6, in_pos ? "$" + str.tostring(math.round(chan_stop, 2)) : "—",
               text_color=color.red, text_size=size.small)
    table.cell(tbl, 0, 7, "ATR",        text_color=color.white,  text_size=size.small)
    table.cell(tbl, 1, 7, str.tostring(math.round(atr_val, 2)),
               text_color=color.white, text_size=size.small)

// ── ALERT CONDITIONS ──────────────────────────────────────────────────────────
alertcondition(cross_up and not halted,
     title="ENTRY — EMA cross-up",
     message="{{ticker}} Daily: EMA cross-up + regime OK. BUY at {{close}}. ATR={{plot_2}}")

alertcondition(cross_down and in_pos,
     title="EXIT — EMA cross-down",
     message="{{ticker}} Daily: EMA cross-down. CLOSE LONG at {{close}}.")

alertcondition(stop_hit,
     title="EXIT — Chandelier stop hit",
     message="{{ticker}} Daily: Chandelier stop hit. CLOSE LONG at {{close}}.")

alertcondition(halted and not halted[1],
     title="CIRCUIT BREAKER fired",
     message="{{ticker}} Daily: Circuit breaker fired — FLATTEN ALL. Daily DD: {{plot_4}}%, Weekly DD: {{plot_5}}%.")
